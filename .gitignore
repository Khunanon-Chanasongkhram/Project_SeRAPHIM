# Everything under /data is generated: snapshots, the time-partitioned archive, and
# the forecast cache. None of it belongs in git — ~600 KB/snapshot x 48/day would add
# ~10 GB/year. Snapshots publish to Cloudflare R2; the cache is restored by actions/cache.
# Ignoring the whole directory rather than each subdirectory, so a new kind of generated
# output cannot slip in the way /data/cache/ did.
/data/

__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.DS_Store
.pytest_cache/
node_modules/
