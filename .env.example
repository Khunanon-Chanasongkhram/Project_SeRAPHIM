# Cloudflare R2 / Pages publishing (Phase 0 runs fine without these — output stays local)
CF_ACCOUNT_ID=
CF_R2_BUCKET=seraphim-snapshots
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# Google Flood Hub (Flood Forecasting API). Optional: without it the layer is simply
# absent and the map says why. Access is gated behind a pilot waitlist, see
# https://developers.google.com/flood-forecasting. Data is CC BY 4.0, attribution
# mandatory, free tier non-commercial. Used in CI only; it never reaches a browser.
GOOGLE_FLOOD_API_KEY=
